# Copie para ~/.dbt/profiles.yml (ou defina DBT_PROFILES_DIR).
# NUNCA versione o arquivo preenchido — ele fica no .gitignore.
alles_dw:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5433') | int }}"
      user: "{{ env_var('POSTGRES_USER') }}"
      password: "{{ env_var('POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('POSTGRES_DB') }}"
      schema: prata
      threads: 4
