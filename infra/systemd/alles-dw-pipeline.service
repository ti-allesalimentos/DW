[Unit]
Description=Alles DW — ciclo de extracao incremental + dbt build
# Nao roda se o Postgres do docker compose ainda nao subiu no boot.
After=docker.service network-online.target
Wants=network-online.target
OnFailure=alles-dw-alerta@%n.service

[Service]
Type=oneshot
User=alles-dw
Group=alles-dw
WorkingDirectory=/opt/alles-dataplatform
ExecStart=/opt/alles-dataplatform/infra/scripts/rodar_pipeline.sh
# 2h = o intervalo do timer. Com 1 vCPU o ciclo (extracao + dbt build, que sozinho
# leva ~28 min) passou dos 45 min iniciais e era morto no meio. Um ciclo que
# estoura 2h indica que o agendamento esta errado para o hardware; o alerta
# OnFailure avisa. O MERGE e transacional, entao abortar nao corrompe o bronze.
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
