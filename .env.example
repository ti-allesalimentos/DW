# ===== Data warehouse (Postgres) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=alles_dw
POSTGRES_USER=alles
POSTGRES_PASSWORD=troque_esta_senha

# ===== Protheus (SQL Server de origem) =====
# Usuario SOMENTE LEITURA. Nunca versionar este arquivo preenchido.
PROTHEUS_HOST=
PROTHEUS_PORT=1433
PROTHEUS_DB=
PROTHEUS_USER=
PROTHEUS_PASSWORD=

# ===== API de trigger (painel de execucao sob demanda) =====
# Chave compartilhada com quem consome a API (hoje: modulo `dw` do Oryon).
# Gere algo forte, ex.: python -c "import secrets; print(secrets.token_hex(32))"
TRIGGER_API_KEY=

# ===== Alerta de falha do pipeline (e-mail) =====
# Usado por infra/scripts/alertar_falha.sh (systemd OnFailure=). Se SMTP_HOST
# e ALERTA_EMAIL_TO estiverem vazios, o alerta fica so no log/journal.
# Porta 465 = SSL; 587/25 = STARTTLS quando disponivel. SMTP_USER/PASSWORD
# podem ficar vazios num relay interno sem autenticacao.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERTA_EMAIL_FROM=alles-dw@allesalimentos.com.br
ALERTA_EMAIL_TO=            # destinatarios separados por virgula

# ===== Parametros de carga =====
# Dias reprocessados a cada carga incremental, para capturar
# cancelamentos e lancamentos retroativos.
JANELA_MOVEL_DIAS=45
# Data de entrada do Protheus. Nada anterior a isso e faturamento.
DATA_INICIO_PROTHEUS=2025-02-01
